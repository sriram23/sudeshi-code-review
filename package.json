{
  "name": "sudeshi-code-review",
  "version": "0.1.0",
  "description": "A TypeScript and React code review CLI with security rules and optional Sarvam AI analysis.",
  "homepage": "https://github.com/sriram23/sudeshi-code-review#readme",
  "bugs": {
    "url": "https://github.com/sriram23/sudeshi-code-review/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sriram23/sudeshi-code-review.git"
  },
  "license": "MIT",
  "author": "Sriram B",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lint": "eslint",
    "format": "prettier --write .",
    "setup:hooks": "husky",
    "test:watch": "vitest",
    "format:check": "prettier --check .",
    "prepack": "npm run build"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.9",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "bin": {
    "sudeshi-code-review": "dist/index.js"
  },
  "engines": {
    "node": ">=24"
  }
}
